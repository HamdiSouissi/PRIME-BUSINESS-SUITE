# Prime Business Suite — exemple de configuration.
# Copier ce fichier vers `.env` (jamais commité : voir .gitignore) et adapter.
#   cp .env.example .env
# Les noms courts ci-dessous (SECRET_KEY, DEBUG, ALLOWED_HOSTS) sont reconnus
# par backend/config/settings.py, qui accepte aussi les variantes préfixées
# DJANGO_SECRET_KEY / DJANGO_DEBUG / DJANGO_ALLOWED_HOSTS.

# --- Django ---
# Générer une longue chaîne aléatoire, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-cle-aleatoire-longue
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# --- PostgreSQL ---
POSTGRES_DB=pbs
POSTGRES_USER=pbs
# ⚠️ N'est appliqué qu'à la PREMIÈRE initialisation du volume Docker `pgdata`.
# Sur un volume existant, modifier cette valeur casse l'authentification du
# backend (FATAL: password authentication failed) — voir docs/demarrage.md § Dépannage.
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# --- Chiffrement des clés API de l'assistant IA (Fernet, 44 caractères base64) ---
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- CORS (origines du frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Amorçage du compte de démonstration au démarrage (JAMAIS en production) ---
# 1 = exécute automatiquement `python manage.py seed_demo`
DEMO_SEED=0
