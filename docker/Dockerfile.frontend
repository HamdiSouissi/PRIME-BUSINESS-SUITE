# Build frontend puis service statique via Nginx, proxy API vers le backend
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/ ./
# node_modules/dist de l'hôte sont exclus par /.dockerignore ; on force une
# installation propre APRES la copie pour être robuste même sans .dockerignore
RUN rm -rf node_modules && npm ci --no-audit --no-fund
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
