# Image backend Prime Business Suite — base Debian slim, WeasyPrint complet (pango)
FROM python:3.12-slim-bookworm AS backend

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dépendances système : WeasyPrint (pango/cairo), Pillow, psycopg, compilation éventuelle
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libffi-dev \
    libcairo2 libgdk-pixbuf-2.0-0 fonts-dejavu-core \
    libjpeg62-turbo zlib1g shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt gunicorn==22.0.0

COPY backend/ /app/

# Utilisateur non-root
RUN useradd --create-home pbs && chown -R pbs:pbs /app
USER pbs

EXPOSE 8000

# Sonde de santé : l'API répond-elle vraiment (migrations passées, DB joignable) ?
# Pas de curl dans l'image slim : urllib (bibliothèque standard) suffit.
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health/', timeout=4).status == 200 else 1)"

# Lancement : migrations (+ données de démo si DEMO_SEED=1) puis serveur WSGI
CMD ["sh", "-c", "python manage.py migrate && { [ \"${DEMO_SEED:-0}\" = \"1\" ] && python manage.py seed_demo || true; } && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
